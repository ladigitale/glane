# Copied onto the Tadaaa host at deploy/cohost/glane.caddy (directory volume).
# Do not Docker-mount this file into /etc/caddy/cohost/ (parent is already a RO volume).
# Hosts come from edge container env (see compose.prod.glane-cohost.yaml).
# Source: Glane repo deploy/tadaaa-cohost/glane.caddy. `agent_ready` is the snippet defined in Tadaaa deploy/Caddyfile.edge.

{$GLANE_APP_SERVER_NAME:glane.example.com} {
	encode zstd gzip
	root * /srv-glane
	# Routes from Glane apps/web/src/app/router.ts (parsePath).
	@spa_route path_regexp ^/(?:(?:capture|workspace|library|privacy|sync|connector|diagnostic|account|project|synth)/?)?$|^/(?:listen|sample|session|project)/[^/]+/?$|^/synth/
	import agent_ready

	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "browsing-topics=()"
	}
}

{$GLANE_API_SERVER_NAME:glane-api.example.com} {
	# Claude connector: MCP endpoint + WebSocket bridge (apps/mcp)
	@agent path /mcp/* /agent/*
	handle @agent {
		reverse_proxy glane-mcp:8787
	}

	encode zstd gzip
	# COEP on the app requires CORP (or CORS) for cross-origin media (listen MP3).
	header Cross-Origin-Resource-Policy cross-origin
	reverse_proxy glane-php:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
