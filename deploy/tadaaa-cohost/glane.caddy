# Copied onto the Tadaaa host at deploy/cohost/glane.caddy (directory volume).
# Do not Docker-mount this file into /etc/caddy/cohost/ (parent is already a RO volume).
# Hosts come from edge container env (see compose.prod.glane-cohost.yaml).

{$GLANE_APP_SERVER_NAME:glane.example.com} {
	encode zstd gzip
	root * /srv-glane
	try_files {path} /index.html
	file_server

	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "browsing-topics=()"
	}
}

{$GLANE_API_SERVER_NAME:glane-api.example.com} {
	encode zstd gzip
	# COEP on the app requires CORP (or CORS) for cross-origin media (listen MP3).
	header Cross-Origin-Resource-Policy cross-origin
	reverse_proxy glane-php:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
