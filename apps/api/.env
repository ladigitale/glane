# Committed placeholders for `composer dump-env` (Docker build).
# Runtime secrets come from Compose / root `.env` (they override these).
APP_ENV=dev
APP_SECRET=ChangeMeToARandomSecretKey32chars
APP_NAME=Glane
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/glane?serverVersion=16&charset=utf8"
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
MERCURE_ENABLED=0
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=glane
FRONT_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:8081/api/publish/soundcloud/callback
