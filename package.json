{
  "name": "glane-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "status": "bash scripts/glane.sh status",
    "setup": "bash scripts/glane.sh setup",
    "update": "bash scripts/glane.sh update",
    "env:up": "bash scripts/glane.sh env:up",
    "env:down": "bash scripts/glane.sh env:down",
    "env:restart": "bash scripts/glane.sh env:restart",
    "jwt:generate": "bash scripts/glane.sh jwt",
    "dev": "yarn --cwd apps/web dev",
    "start": "yarn dev",
    "build": "yarn --cwd apps/web build",
    "preview": "yarn --cwd apps/web preview",
    "typecheck": "yarn workspaces run typecheck",
    "ai:sync": "node scripts/sync-ai.mjs",
    "test": "yarn --cwd packages/audio-dsp test && yarn --cwd packages/gestures test && yarn --cwd packages/core-model test && yarn --cwd packages/audio-io test && yarn --cwd packages/audio-ml test",
    "api:up": "yarn env:up",
    "api:down": "yarn env:down",
    "api:logs": "docker compose logs -f php database",
    "api:ps": "docker compose ps",
    "api:console": "docker compose exec php bin/console",
    "api:migrate": "docker compose exec php bin/console doctrine:migrations:migrate --no-interaction",
    "api:composer": "docker compose exec php composer",
    "api:sh": "docker compose exec php sh",
    "prod:install": "bash scripts/install-prod.sh",
    "prod:update": "bash scripts/update-prod.sh"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "tsx": "4.19.2"
  }
}
